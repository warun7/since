# Required. One DeepSeek key powers both the model and web search
# (DeepSeek Search API, https://api-docs.deepseek.com/guides/search).
DEEPSEEK_API_KEY=

# Optional overrides
# CHAT_MODEL=deepseek-flash          # the model that talks to you and searches
# MEMORY_MODEL=deepseek-flash        # the model that writes long-term memory in the background
# PORT=3000
# DB_PATH=data/since.db
# MAX_SEARCH_STEPS=3
# DEFAULT_TZ=Europe/London           # used only when the browser doesn't send its timezone

# Optional: citation checking with upheld (https://github.com/warun7/upheld).
# Run `upheld serve` and point this at it; each answer's citations are then checked
# against the passages the model was shown, after the answer has streamed.
# UPHELD_URL=http://127.0.0.1:8000
